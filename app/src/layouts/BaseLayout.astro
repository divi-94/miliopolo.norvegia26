---
import '../styles/global.css';
import { pathWithBase } from '@/lib/paths';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Norvegia 2026',
  description = 'Il cruscotto operativo del viaggio in Norvegia, dal 9 al 23 agosto 2026.',
} = Astro.props;
const pathname = Astro.url.pathname;
const isHome = pathname === pathWithBase();
const isCuriosities = pathname.startsWith(pathWithBase('curiosita/'));
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#082f49" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#contenuto">Vai al contenuto</a>
    <header class="site-header">
      <a class="brand" href={pathWithBase()} aria-label="Norvegia 2026, home">
        <span class="brand__eyebrow">9–23 agosto</span>
        <span>Norvegia 2026</span>
      </a>
      <a class="header-link" href={pathWithBase('info/')}>Info</a>
    </header>
    <main id="contenuto">
      <slot />
    </main>
    <nav class="bottom-nav" aria-label="Navigazione principale">
      <a href={pathWithBase()} aria-current={isHome ? 'page' : undefined}>Viaggio</a>
      <a data-today-link href={pathWithBase('giorni/2026-08-09/')}>Oggi</a>
      <a href={pathWithBase('curiosita/')} aria-current={isCuriosities ? 'page' : undefined}>Curiosità</a>
    </nav>
    <script>
      import { osloDate, targetDay } from '@/lib/trip';
      const params = new URLSearchParams(window.location.search);
      const simulated = params.get('date');
      const current = simulated && /^\d{4}-\d{2}-\d{2}$/.test(simulated) ? simulated : osloDate();
      const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
      for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-today-link]')) {
        link.href = `${base}giorni/${targetDay(current)}/`;
      }
    </script>
  </body>
</html>
