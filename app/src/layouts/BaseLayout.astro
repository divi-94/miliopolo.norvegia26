---
import '../styles/global.css';
import { pathWithBase } from '@/lib/paths';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Norvegia 2026',
  description = 'Il cruscotto operativo del viaggio in Norvegia, dal 9 al 23 agosto 2026.',
} = Astro.props;
const pathname = Astro.url.pathname;
const isHome = pathname === pathWithBase();
const isCuriosities = pathname.startsWith(pathWithBase('curiosita/'));
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#082f49" />
    <link rel="icon" href={pathWithBase('app-icon.svg')} type="image/svg+xml" />
    <link rel="manifest" href={pathWithBase('manifest.webmanifest')} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#contenuto">Vai al contenuto</a>
    <header class="site-header">
      <a class="brand" href={pathWithBase()} aria-label="Norvegia 2026, home">
        <span class="brand__eyebrow">9–23 agosto</span>
        <span>Norvegia 2026</span>
      </a>
      <a class="header-link" href={pathWithBase('info/')}>Info</a>
    </header>
    <main id="contenuto">
      <slot />
    </main>
    <aside class="app-status" aria-live="polite">
      <span data-offline-status hidden>Sei offline · contenuti salvati disponibili</span>
      <button type="button" data-app-update hidden>Aggiornamento disponibile · ricarica</button>
    </aside>
    <nav class="bottom-nav" aria-label="Navigazione principale">
      <a href={pathWithBase()} aria-current={isHome ? 'page' : undefined}>Viaggio</a>
      <a data-today-link href={pathWithBase('giorni/2026-08-09/')}>Oggi</a>
      <a href={pathWithBase('curiosita/')} aria-current={isCuriosities ? 'page' : undefined}>Curiosità</a>
    </nav>
    <script>
      import { osloDate, targetDay } from '@/lib/trip';
      const params = new URLSearchParams(window.location.search);
      const simulated = params.get('date');
      const current = simulated && /^\d{4}-\d{2}-\d{2}$/.test(simulated) ? simulated : osloDate();
      const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
      for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-today-link]')) {
        link.href = `${base}giorni/${targetDay(current)}/`;
      }

      const editorKey = 'norvegia-editor-mode';
      const editParameter = params.get('edit');
      try {
        if (editParameter === '1') localStorage.setItem(editorKey, '1');
        if (editParameter === '0') localStorage.removeItem(editorKey);
      } catch {
        // La modalità tramite parametro continua a funzionare anche se lo storage è indisponibile.
      }

      function editorIsActive() {
        if (editParameter === '1') return true;
        if (editParameter === '0') return false;
        try { return localStorage.getItem(editorKey) === '1'; } catch { return false; }
      }

      function renderEditorMode(active: boolean) {
        document.documentElement.dataset.editor = active ? 'on' : 'off';
        for (const element of document.querySelectorAll<HTMLElement>('[data-editor-only]')) element.hidden = !active;
        for (const element of document.querySelectorAll<HTMLElement>('[data-editor-enable]')) element.hidden = active;
        for (const element of document.querySelectorAll<HTMLElement>('[data-editor-disable]')) element.hidden = !active;
        for (const element of document.querySelectorAll<HTMLElement>('[data-editor-state]')) {
          element.textContent = active ? 'Modalità editor attiva' : 'Modalità editor non attiva';
        }
      }

      renderEditorMode(editorIsActive());
      for (const button of document.querySelectorAll<HTMLElement>('[data-editor-enable]')) {
        button.addEventListener('click', () => {
          try { localStorage.setItem(editorKey, '1'); } catch { /* nessun salvataggio persistente */ }
          renderEditorMode(true);
        });
      }
      for (const button of document.querySelectorAll<HTMLElement>('[data-editor-disable]')) {
        button.addEventListener('click', () => {
          try { localStorage.removeItem(editorKey); } catch { /* modalità corrente comunque disattivata */ }
          renderEditorMode(false);
        });
      }

      const offlineStatus = document.querySelector<HTMLElement>('[data-offline-status]');
      function renderConnectivity(online = navigator.onLine) {
        if (offlineStatus) offlineStatus.hidden = online;
      }
      renderConnectivity();
      window.addEventListener('online', () => renderConnectivity(true));
      window.addEventListener('offline', () => renderConnectivity(false));

      const updateButton = document.querySelector<HTMLButtonElement>('[data-app-update]');
      function offerUpdate(worker: ServiceWorker | null) {
        if (!worker || !updateButton) return;
        updateButton.hidden = false;
        updateButton.onclick = () => worker.postMessage('SKIP_WAITING');
      }

      if ('serviceWorker' in navigator) {
        const hadController = Boolean(navigator.serviceWorker.controller);
        const swUrl = `${base}sw.js`;
        navigator.serviceWorker.register(swUrl, { scope: base }).then((registration) => {
          offerUpdate(registration.waiting);
          registration.addEventListener('updatefound', () => {
            const worker = registration.installing;
            worker?.addEventListener('statechange', () => {
              if (worker.state === 'installed' && navigator.serviceWorker.controller) offerUpdate(worker);
            });
          });
        }).catch(() => {
          // L'app statica resta pienamente leggibile se la registrazione non è disponibile.
        });
        let refreshing = false;
        navigator.serviceWorker.addEventListener('controllerchange', () => {
          if (!hadController || refreshing) return;
          refreshing = true;
          window.location.reload();
        });
      }
    </script>
  </body>
</html>
