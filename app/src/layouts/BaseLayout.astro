---
import '../styles/global.css';
import { pathWithBase } from '@/lib/paths';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Norvegia 2026',
  description = 'Il cruscotto operativo del viaggio in Norvegia, dal 9 al 23 agosto 2026.',
} = Astro.props;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#082f49" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#contenuto">Vai al contenuto</a>
    <header class="site-header">
      <a class="brand" href={pathWithBase()} aria-label="Norvegia 2026, home">
        <span class="brand__eyebrow">9–23 agosto</span>
        <span>Norvegia 2026</span>
      </a>
      <a class="header-link" href={pathWithBase('info/')}>Info</a>
    </header>
    <main id="contenuto">
      <slot />
    </main>
    <nav class="bottom-nav" aria-label="Navigazione principale">
      <a href={pathWithBase()} aria-current={Astro.url.pathname === pathWithBase() ? 'page' : undefined}>Viaggio</a>
      <a href={pathWithBase('giorni/2026-08-09/')}>Oggi</a>
      <a href={pathWithBase('curiosita/')}>Curiosità</a>
    </nav>
  </body>
</html>
