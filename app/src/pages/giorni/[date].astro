---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPlace, getPlaces } from '@/lib/places';
import { pathWithBase } from '@/lib/paths';
import { countOpenTasks, drivingLevel, formatDuration, hikeLevel } from '@/lib/trip';
import { curiosityTypeLabel } from '@/lib/curiosities';
import { dayEditorUrl } from '@/lib/editor';

export async function getStaticPaths() {
  const days = (await getCollection('days')).sort((a, b) => a.data.dayNumber - b.data.dayNumber);
  const places = getPlaces();
  return days.map((day, index) => ({
    params: { date: day.data.date },
    props: {
      day,
      previous: days[index - 1],
      next: days[index + 1],
      relatedPlaces: day.data.places.flatMap((slug) => {
        const place = places.find((candidate) => candidate.slug === slug);
        return place ? [place] : [];
      }),
    },
  }));
}

const { day, previous, next, relatedPlaces } = Astro.props;
const relatedCuriosities = (await getCollection('curiosities')).filter((item) => item.data.days.includes(day.data.date));
const weatherPlace = day.data.weatherPrimary ? getPlace(day.data.weatherPrimary) : undefined;
const safetySensitive = ['galdhopiggen', 'skala', 'trolltunga', 'skomakarnibba', 'preikestolen', 'vidden'].includes(day.data.weatherPrimary ?? '');
const { Content } = await render(day);
const drive = drivingLevel(day.data.drivingMinutes);
const hike = hikeLevel(day.data.hike);
const openTasks = countOpenTasks(day.body ?? '');
const dateLabel = new Intl.DateTimeFormat('it-IT', {
  timeZone: 'Europe/Oslo', weekday: 'long', day: 'numeric', month: 'long', year: 'numeric',
}).format(new Date(`${day.data.date}T12:00:00Z`));
---

<BaseLayout title={`${day.data.title} · Norvegia 2026`}>
  <article class="day-detail prose">
    <a class="back-link" href={pathWithBase()}>← Tutte le giornate</a>
    <p class="kicker">Giorno {day.data.dayNumber} · {dateLabel}</p>
    <h1>{day.data.title}</h1>
    <p class="lead">{day.data.route}</p>
    <a class="editor-action" data-editor-only hidden href={dayEditorUrl(day.data.date)} target="_blank" rel="noopener noreferrer">Modifica questa giornata su GitHub <span aria-hidden="true">↗</span></a>
    <div class="detail-summary" aria-label="Riepilogo della giornata">
      <span><small>Stato</small><strong>{day.data.status}</strong></span>
      <span><small>Base</small><strong>{day.data.base ?? 'Rientro'}</strong></span>
      {drive && day.data.drivingMinutes !== null && <span><small>Guida · {drive}</small><strong>{formatDuration(day.data.drivingMinutes)}</strong></span>}
      {hike && <span><small>Trekking · {hike}</small><strong>{day.data.hike?.durationHours ? `${day.data.hike.durationHours}h` : 'Variabile'}</strong></span>}
      {openTasks > 0 && <span><small>Attività</small><strong>{openTasks} aperte</strong></span>}
    </div>
    {weatherPlace?.coordinates && (
      <section
        class="weather-panel"
        data-weather-point
        data-weather-mode="detail"
        data-weather-date={day.data.date}
        data-weather-name={weatherPlace.name}
        data-latitude={weatherPlace.coordinates.latitude}
        data-longitude={weatherPlace.coordinates.longitude}
        data-elevation={weatherPlace.elevationM}
        aria-labelledby="weather-title"
      >
        <p class="panel__label">Previsione locale</p>
        <h2 id="weather-title">Meteo · {weatherPlace.name}</h2>
        <p class="weather-panel__state" data-weather-state>Caricamento non bloccante…</p>
        <div data-weather-content hidden>
          <div class="weather-daily" aria-label="Riepilogo meteo giornaliero">
            <span><small>Condizioni</small><strong data-weather-condition>—</strong></span>
            <span><small>Min · max</small><strong data-weather-temperature>—</strong></span>
            <span><small>Pioggia</small><strong data-weather-rain>—</strong></span>
            <span><small>Vento · raffiche</small><strong data-weather-wind>—</strong></span>
            <span><small>Alba · tramonto</small><strong data-weather-sun>—</strong></span>
          </div>
          <div class="weather-hourly" data-weather-hourly aria-label="Previsione per fasce orarie"></div>
          <p class="weather-updated" data-weather-updated></p>
        </div>
        <p class="weather-attribution">Dati: <a href="https://open-meteo.com/" target="_blank" rel="noopener noreferrer">Open-Meteo</a>. Previsione informativa, non una valutazione di sicurezza.</p>
        {safetySensitive && (
          <p class="safety-callout"><strong>Escursione sensibile:</strong> prima di partire confronta la previsione con <a href="https://www.yr.no/en" target="_blank" rel="noopener noreferrer">Yr / MET Norway</a>, le indicazioni del gestore e <a href="https://ut.no/" target="_blank" rel="noopener noreferrer">UT.no</a>. Il meteo non attiva automaticamente un piano B.</p>
        )}
      </section>
    )}
    <Content />

    {relatedPlaces.length > 0 && (
      <section class="related-section" aria-labelledby="places-title">
        <h2 id="places-title">Luoghi della giornata</h2>
        <div class="place-chips">
          {relatedPlaces.map((place) => <a href={pathWithBase(`luoghi/${place.slug}/`)}>{place.name}</a>)}
        </div>
      </section>
    )}

    {relatedCuriosities.length > 0 && (
      <section class="related-section" aria-labelledby="day-curiosities-title">
        <h2 id="day-curiosities-title">Storie della giornata</h2>
        <div class="linked-list">
          {relatedCuriosities.map((item) => <a href={pathWithBase(`curiosita/${item.data.slug}/`)}><span>{curiosityTypeLabel[item.data.type]}</span><strong>{item.data.title}</strong></a>)}
        </div>
      </section>
    )}

    <nav class="day-pagination" aria-label="Giornate precedente e successiva">
      {previous ? <a href={pathWithBase(`giorni/${previous.data.date}/`)}><span>← Giorno {previous.data.dayNumber}</span><strong>{previous.data.title}</strong></a> : <span />}
      {next ? <a href={pathWithBase(`giorni/${next.data.date}/`)}><span>Giorno {next.data.dayNumber} →</span><strong>{next.data.title}</strong></a> : <span />}
    </nav>
  </article>
</BaseLayout>
