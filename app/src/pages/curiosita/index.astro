---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { curiosityTypeLabel, readingMinutes } from '@/lib/curiosities';
import { getPlaces } from '@/lib/places';
import { pathWithBase } from '@/lib/paths';

const places = getPlaces();
const placeBySlug = new Map(places.map((place) => [place.slug, place]));
const curiosities = (await getCollection('curiosities')).sort((a, b) => {
  const placeA = placeBySlug.get(a.data.places[0]);
  const placeB = placeBySlug.get(b.data.places[0]);
  return `${placeA?.area ?? ''}\0${placeA?.name ?? ''}\0${a.data.title}`.localeCompare(
    `${placeB?.area ?? ''}\0${placeB?.name ?? ''}\0${b.data.title}`,
    'it',
  );
});
const days = (await getCollection('days')).sort((a, b) => a.data.dayNumber - b.data.dayNumber);
const groups = Map.groupBy(curiosities, (item) => item.data.places[0]);
---

<BaseLayout title="Curiosità · Norvegia 2026">
  <section class="curiosity-index">
    <p class="kicker">Storie lungo la strada</p>
    <h1>Curiosità</h1>
    <p class="lead">51 storie, fatti e leggende da leggere nei luoghi in cui sono accaduti.</p>

    <div class="curiosity-filters" aria-label="Filtri delle curiosità">
      <label>
        <span>Cerca</span>
        <input data-curiosity-search type="search" placeholder="Titolo, luogo o parola…" autocomplete="off" />
      </label>
      <label>
        <span>Giornata</span>
        <select data-curiosity-day>
          <option value="">Tutto il viaggio</option>
          {days.map((day) => <option value={day.data.date}>Giorno {day.data.dayNumber} · {day.data.title}</option>)}
        </select>
      </label>
    </div>

    <p class="filter-result" data-filter-result aria-live="polite">51 curiosità</p>

    <div class="curiosity-groups">
      {[...groups].map(([placeSlug, items]) => {
        const place = placeBySlug.get(placeSlug);
        return (
          <section class="curiosity-group" data-curiosity-group aria-labelledby={`place-${placeSlug}`}>
            <div class="curiosity-group__heading">
              <div>
                <p>{place?.area}</p>
                <h2 id={`place-${placeSlug}`}>{place?.name ?? placeSlug}</h2>
              </div>
              <a href={pathWithBase(`luoghi/${placeSlug}/`)}>Vedi luogo →</a>
            </div>
            <div class="curiosity-grid">
              {items.map((item) => (
                <article
                  class="curiosity-card"
                  data-curiosity-card
                  data-days={item.data.days.join(' ')}
                  data-search={`${item.data.title} ${item.data.excerpt ?? ''} ${item.data.places.map((slug) => placeBySlug.get(slug)?.name ?? slug).join(' ')}`.toLocaleLowerCase('it')}
                >
                  <div class="curiosity-card__meta">
                    <span class={`story-type story-type--${item.data.type}`}>{curiosityTypeLabel[item.data.type]}</span>
                    <span>{readingMinutes(item.body ?? '')} min</span>
                  </div>
                  <h3><a href={pathWithBase(`curiosita/${item.data.slug}/`)}>{item.data.title}</a></h3>
                  {item.data.excerpt && <p>{item.data.excerpt}</p>}
                </article>
              ))}
            </div>
          </section>
        );
      })}
    </div>
    <p class="empty-filter" data-empty-filter hidden>Nessuna curiosità corrisponde ai filtri.</p>
  </section>
</BaseLayout>

<script>
  const search = document.querySelector<HTMLInputElement>('[data-curiosity-search]');
  const day = document.querySelector<HTMLSelectElement>('[data-curiosity-day]');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-curiosity-card]')];
  const groups = [...document.querySelectorAll<HTMLElement>('[data-curiosity-group]')];
  const result = document.querySelector<HTMLElement>('[data-filter-result]');
  const empty = document.querySelector<HTMLElement>('[data-empty-filter]');

  function applyFilters() {
    const query = search?.value.trim().toLocaleLowerCase('it') ?? '';
    const selectedDay = day?.value ?? '';
    let visible = 0;
    for (const card of cards) {
      const matchesText = !query || card.dataset.search?.includes(query);
      const matchesDay = !selectedDay || card.dataset.days?.split(' ').includes(selectedDay);
      card.hidden = !(matchesText && matchesDay);
      if (!card.hidden) visible += 1;
    }
    for (const group of groups) {
      group.hidden = !group.querySelector('[data-curiosity-card]:not([hidden])');
    }
    if (result) result.textContent = `${visible} curiosità`;
    if (empty) empty.hidden = visible !== 0;
  }

  search?.addEventListener('input', applyFilters);
  day?.addEventListener('change', applyFilters);
</script>
